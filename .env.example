# Names only. Never put values in this file or in git.
# `neon deploy` writes the real values to .env.local (gitignored).
# Zeusi reads the first set name in each list (see src/config.ts).

# Pooled URL — ordinary CLI queries (fact add/get, vector-probe, prove)
DATABASE_URL=

# Direct (unpooled) URL — migrations and CREATE EXTENSION (also: DIRECT_URL, POSTGRES_URL_NON_POOLING)
DATABASE_URL_UNPOOLED=

# Optional overrides
ZEUSI_DATABASE_URL=
ZEUSI_DIRECT_URL=
# Host label recorded in ingest_runs (mini | box | cloud ...)
ZEUSI_HOST=

# OpenAI key is read from the macOS Keychain item zeusi-openai-api-key, not from this file.

# Endpoint id of the Neon DEFAULT (main) branch, e.g. ep-xxxx-123456 (an id, not a secret).
# prove / embed-smoke write probe rows: they refuse (offline) unless this is set and the
# owner URL is a DIFFERENT endpoint (a branch), or --i-know-this-is-main is passed.
# Bare id, pooled id (ep-...-pooler) or the endpoint hostname all work (normalised);
# any other value is refused.
ZEUSI_MAIN_ENDPOINT_ID=

# Optional: who reaches the shared team workspace on the hosted OAuth sign-in
# (comma-separated, lower-cased). Leave empty to use the example lists in code.
# ZEUSI_OPERATOR_GITHUB_LOGINS=
# ZEUSI_OPERATOR_EMAILS=

# Optional. Semantic search uses this; without it, search is lexical only.
# ZEUSI_OPENAI_API_KEY=
