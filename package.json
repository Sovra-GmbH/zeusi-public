{
  "name": "zeusi",
  "version": "0.1.0",
  "private": true,
  "description": "Zeusi: Neon Postgres + pgvector memory and work-tracking DB. Thin v1 CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zeusi": "dist/cli.js",
    "zeusi-mcp": "dist/mcp.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node scripts/test-hermetic.ts",
    "check": "node scripts/check.ts",
    "guards": "node scripts/guards/run.ts",
    "migrate": "node dist/cli.js migrate",
    "prove": "node dist/cli.js prove",
    "neon:init": "neon init -y --branch production --services postgres",
    "neon:deploy": "neon deploy",
    "embed-smoke": "node dist/cli.js embed-smoke",
    "hooks:install": "sh scripts/install-hooks.sh",
    "secret-scan": "gitleaks git --redact --no-banner --config .gitleaks.toml .",
    "wall:dryrun": "node scripts/wall-dryrun.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^1.2.1",
    "@noble/hashes": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
